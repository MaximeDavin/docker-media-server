# Installed by symlink - see the timer for the commands.
[Unit]
Description=Snapshot config, then update the media server images
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=max
Group=max
# Read-anything, so restic can snapshot files owned by container uids under
# ~/.config. Not root: compose must expand ${HOME} to /home/max.
AmbientCapabilities=CAP_DAC_READ_SEARCH
ExecStart=/home/max/docker-media-server/tools/update.sh
